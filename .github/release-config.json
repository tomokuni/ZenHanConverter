{
  "product": "ZenHanConverter",
  "versionFile": "Directory.Build.props",
  "solutionFile": "ZenHanConverter.slnx",
  "layout": {
    "roots": ["src"],
    "projectTitleStyle": "name",
    "solutionLabels": ["ZenHanConverter.slnx"],
    "scriptRoots": ["buildScript", ".github"]
  },
  "gateWorkflow": "build.yml",
  "releaseBranches": [
    "main"
  ],
  "dryRunBranches": [
    "main",
    "dev"
  ],
  "settingsFiles": ["AppSetting.json", "Settings.json"],
  "requiredBuildProps": ["EnforceCodeStyleInBuild", "GenerateDocumentationFile", "CopyDocumentationFileToOutputDirectory", "PublishDocumentationFiles", "AnalysisLevel", "AnalysisMode", "TreatWarningsAsErrors"],
  "executableArchitecture": "x64",
  "artifactRetentionDays": 30,
  "releaseNotes": "4 種の UI 実装の配布物です。いずれも zip で、展開すると exe が入っています（Avalonia UI 版はネイティブ DLL、WinUI 3 版はネイティブ DLL と XAML リソースも入っています）。",
  "uis": [
    {
      "name": "MewUI",
      "script": "buildScript/publish_MewUI.bat",
      "output": "publish/mewui-win-x64-aot",
      "exe": "ZenHanConverter.MewUI.exe",
      "asset": "ZenHanConverter.MewUI.{version}.zip",
      "zip": true
    },
    {
      "name": "WinUI3",
      "script": "buildScript/publish_WinUI3.bat",
      "exe": "ZenHanConverter.WinUI3.exe",
      "zip": true,
      "requiresWindowsAppRuntime": true,
      "outputs": [
        {
          "output": "publish/winui3-win-x64-aot",
          "asset": "ZenHanConverter.WinUI3.{version}.zip"
        },
        {
          "output": "publish/winui3-win-x64-single",
          "asset": "ZenHanConverter.WinUI3.Single.{version}.zip"
        }
      ]
    },
    {
      "name": "WinForms",
      "script": "buildScript/publish_WinForms.bat",
      "output": "publish/winforms-win-x64-single",
      "exe": "ZenHanConverter.WinForms.exe",
      "asset": "ZenHanConverter.WinForms.{version}.zip",
      "zip": true
    },
    {
      "name": "AvaloniaUI",
      "script": "buildScript/publish_AvaloniaUI.bat",
      "output": "publish/avaloniaui-win-x64-aot",
      "exe": "ZenHanConverter.AvaloniaUI.exe",
      "asset": "ZenHanConverter.AvaloniaUI.{version}.zip",
      "zip": true
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.26100.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 単数形で固定する（複数形は復元対象の一覧であり、ビルド対象を x64 に固定しない。 規則は .github/ビルド設定規約.md §4） -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- XAML リソース（resources.pri）を必ず生成する。無いと発行した exe が起動時に Microsoft.UI.Xaml.dll で 0xc000027b（E_FAIL）になる（実測 2026-11-07） -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <IncludeReferencedProjectsInXamlTypeResolution>false</IncludeReferencedProjectsInXamlTypeResolution>
    <!-- Windows App SDK のビルド要件（リポジトリ共通の Directory.Build.props には置かない） -->
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <!--
      Trim は AOT 発行のときだけ有効にする。AOT 以外の単一ファイル発行へトリミングを掛けると、
      WinUI と Windows SDK のアセンブリ（トリム未対応）が IL2104 で失敗する（実測 2026-11-07）。
      AOT 発行は publish 時に -p:PublishAot=true で指定する。
    -->
    <PublishTrimmed Condition="'$(PublishAot)' == 'true'">true</PublishTrimmed>
    <TrimMode Condition="'$(PublishAot)' == 'true'">link</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- unsafe は CsWinRT が生成したコードに必要（AOT / Trim 対応） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- エントリ ポイントを自前で持ち、Windows App Runtime の用意を EsUtil.Ui.WinUI3.Interop へ任せる -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!--
      Windows App Runtime を同梱せず、導入済みのランタイムを使う（メモリ・配布サイズを抑える）。
      ランタイムの有無の確認と導入は Program.Main が EsUtil.Ui.WinUI3.Interop の
      WindowsAppRuntimeBootstrap で行うため、モジュール読み込み時の自動初期化は止める。
      自動初期化はこの入口より先に走るため、ランタイムが無い PC では導入の判断へ到達しない。
    -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
  </PropertyGroup>

  <PropertyGroup>
    <Product>ZenHanConverter</Product>
    <Description>ZenHanConverter (WinUI 3) - full-width / half-width text converter</Description>
    <RootNamespace>EsUtil.ZenHanConverter.App.WinUI3</RootNamespace>
    <!-- exe （アセンブリ）名はプロジェクト名に合せる。名前空間は既存の App.WinUI のまま（変更すると全ソース・XAML へ波及するため） -->
    <AssemblyName>ZenHanConverter.WinUI3</AssemblyName>
    <PackageTags>clipboard; zen; han; convert</PackageTags>
    <!--
      CommunityToolkit.WinUI.UI.Controls.DataGrid（第三者）が AOT / トリム解析で IL2104（アセンブリが
      トリム警告を出した）を報告する。このアセンブリは DataGrid のセル テンプレートだけで使い、
      列はすべて DataGridTemplateColumn（プロパティ名の実行時解決を使わない）である。
      理由は .github/ビルド設定規約.md の付録 A に記載する。
    -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\App.Core.Presentation\App.Core.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ZenHanConverter.Tests.App.WinUI3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
    <PackageReference Include="CommunityToolkit.WinUI.UI.Controls.DataGrid" />
    <!-- マルチカラム配置パネル。配置の計算は EsUtil.Feature.ColumnPacking.Core が単一所有する -->
    <PackageReference Include="EsUtil.Ui.WinUI3.ColumnPacking" />
    <!-- Windows App Runtime の用意（確認と導入）を担う -->
    <PackageReference Include="EsUtil.Ui.WinUI3.Interop" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.WinUI.Managed" />
  </ItemGroup>

  <!--
    Windows App SDK の自己完結ペイロードから、本アプリが使わない AI / ML / Search / Widgets / WebView2 を除外する。
    これらは Microsoft.WindowsAppSDK.Runtime の MSIX に含まれるため、パッケージ参照では削れない。
    （onnxruntime.dll 20.7MB / DirectML.dll 17.8MB など、単一 exe で 約 55MB の削減）
    動作確認済み: 除外後も起動・描画・クリップボード変換がすべて正常に動作する。
  -->
  <Target Name="RemoveUnusedWindowsAppSdkPayload"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="PrepareForBundle;CopyFilesToPublishDirectory">
    <ItemGroup>
      <_UnusedWindowsAppSdkPayload Include="@(ResolvedFileToPublish)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)%(Extension)', '^(onnxruntime|DirectML|PerceptiveStreaming|NPUDetect|msquic|Microsoft\.Windows\.(AI|ML|Search|Widgets|Workloads)|Microsoft\.ML\.OnnxRuntime|Microsoft\.Web\.WebView2).*'))" />
      <ResolvedFileToPublish Remove="@(_UnusedWindowsAppSdkPayload)" />
    </ItemGroup>
    <Message Importance="high" Text="WindowsAppSDK の未使用ペイロードを除外: @(_UnusedWindowsAppSdkPayload->Count()) ファイル" />
  </Target>

  </Project>

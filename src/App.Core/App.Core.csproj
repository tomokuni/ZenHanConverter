<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RootNamespace>EsUtil.ZenHanConverter.App.Core</RootNamespace>
    <AssemblyName>ZenHanConverter.App.Core</AssemblyName>
    <Description>Core logic, models and platform APIs for ZenHanConverter (UI framework agnostic)</Description>
    <Copyright>Copyright (c) 2025</Copyright>
    <!-- Win32 P/Invoke（LibraryImport ソース生成）が unsafe コードを生成するため許可する -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- 変換ペアと Win32 実装は EsUtil の公開パッケージが単一所有する（版は Directory.Packages.props） -->
    <PackageReference Include="EsUtil.Feature.ZenHan.Core" />
    <PackageReference Include="EsUtil.Platform.Core" />
    <!-- ログ（出力先・ファイル名・レベルの表記は .github/ログ規約.md が単一所有する） -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!-- アイコン形状は SVG ファイルを唯一の定義元とし、UI フレームワーク非依存のパスデータとして提供する -->
    <EmbeddedResource Include="Icons\**\*.svg" />
  </ItemGroup>

</Project>

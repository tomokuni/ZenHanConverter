<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <UseWinUI>true</UseWinUI>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <RootNamespace>EsUtil.ZenHanConverter.Tests.Parity</RootNamespace>
    <AssemblyName>ZenHanConverter.Tests.Parity</AssemblyName>
    <!-- App.WinUI3（自己完結型）を参照するため Windows App SDK のビルド要件を満たす -->
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <!--
      Windows App SDK の自動初期化を無効にする。
      有効（既定）の場合はアセンブリにモジュール初期化子が埋め込まれ、起動時に
      ブートストラップ（OnNoMatch_ShowUI）が Windows App Runtime を探す。
      インストールされていない環境（CI など）では導入ダイアログを出して待ち続けるため、
      テストが結果を出さないまま停止する。テストは WinRT を使わないため初期化は不要。
    -->
    <WindowsAppSdkAutoInitialize>false</WindowsAppSdkAutoInitialize>
  <SupportedOSPlatformVersion>10.0.18362.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 両 UI の app 層を同時に参照し、同じ入力に対する挙動を直接比較する -->
    <ProjectReference Include="..\..\src\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\..\src\App.WinUI3\App.WinUI3.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      HomeViewModel は各 UI のスレッド委譲方式が異なるため UI ごとの実装のままです（未共通化）。
      一方で App.MewUI / App.WinForms は非自己完結型 exe、App.WinUI3 は自己完結型 exe のため、
      1 つのプロジェクトから同時に参照すると NETSDK1150/1151 で失敗します。
      そこで MewUI 版・WinForms 版はソースをリンクして同一アセンブリへ取り込み、各実装を直接比較します。
      （リンクのため、App.MewUI / App.WinForms 側の変更は自動的にこのテストへ反映されます）

      設定画面の ViewModel（SettingsViewModel / ZenHanConvertItem / ReplacePairItem 等）は
      src/App.Core.Presentation に共通化済みのため、ここで比較する対象はありません。
    -->
    <Compile Include="..\..\src\App.MewUI\ViewModels\HomeViewModel.cs" Link="App.MewUI\ViewModels\HomeViewModel.cs" />
    <Compile Include="..\..\src\App.WinForms\ViewModels\HomeViewModel.cs" Link="App.WinForms\ViewModels\HomeViewModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- テスト共通ヘルパーは test 直下に単一所有し、各テストプロジェクトへリンクして共有する -->
    <Compile Include="..\TestHelper.cs" Link="TestHelper.cs" />
  </ItemGroup>

</Project>
